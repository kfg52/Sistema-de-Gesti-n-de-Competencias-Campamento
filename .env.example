# Variables de Supabase.
# Copia este archivo a .env.local y completa los valores reales.
# Vite solo expone al cliente variables con prefijo VITE_.
# Estas corresponden a los valores del panel de Supabase (Settings > API):
#   Project URL    -> VITE_SUPABASE_URL
#   anon key       -> VITE_SUPABASE_ANON_KEY (nombre anterior)
#                    o VITE_SUPABASE_PUBLISHABLE_KEY (nombre actual, equivalente)
# NUNCA pongas aquí la service_role / secret key: se expondría en el navegador.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key